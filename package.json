{
  "name": "emberfall",
  "version": "1.0.13",
  "scripts": {
    "test": "node tests/headless.js && node tests/rules.js && node tests/fuzz.js 20 && node tests/net.js && node tests/chomp.js && node tests/brand.js && node tests/joey.js && node tests/vargan.js && node tests/sack.js && node tests/knell.js && node tests/kestrel.js && node tests/movelist.js && node tests/pspad.js && node tests/cpu10.js",
    "start": "node serve.js",
    "desktop": "electron .",
    "dist": "node tools/stage-desktop.js && electron-builder --win nsis",
    "release": "node tools/release.js all"
  },
  "type": "commonjs",
  "private": "true",
  "dependencies": {
    "koffi": "3.3.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5"
  },
  "main": "desktop/main.js",
  "description": "Emberfall, an original platform fighter",
  "author": "Emberfall",
  "build": {
    "appId": "com.emberfall.game",
    "productName": "Emberfall",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.js",
      "desktop/preload.js",
      "desktop/eos.js",
      "package.json",
      "desktop/logo/icon-256.png",
      "desktop/updater.js",
      "desktop/update-key.pub.pem"
    ],
    "extraResources": [
      {
        "from": "build/game",
        "to": "game"
      },
      {
        "from": "desktop/eos",
        "to": "eos",
        "filter": [
          "EOSSDK-Win64-Shipping.dll",
          "config.json"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "desktop/logo/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "artifactName": "Emberfall-Setup-${version}.exe",
      "installerIcon": "desktop/logo/icon.ico",
      "uninstallerIcon": "desktop/logo/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Emberfall"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ]
  },
  "emberfall": {
    "releaseRepo": "gasketguru1-cell/emberfall-releases"
  }
}
